.connections-workspace
    aside.connection-list(aria-label='已保存的 SSH 连接')
        .connections-heading
            h2 SSH 连接
            button.btn.btn-primary.btn-sm(type='button', [disabled]='saving', (click)='add()') ＋ SSH
        p.text-muted.empty(*ngIf='!connections.length') 尚未保存 SSH 连接。
        button.connection-row(
            *ngFor='let profile of connections',
            type='button',
            [class.selected]='selected?.id === profile.id',
            [attr.aria-pressed]='selected?.id === profile.id',
            [disabled]='saving',
            (click)='select(profile)',
            (dblclick)='connect(profile)',
            (keydown.enter)='connect(profile); $event.preventDefault()',
        )
            i.fas.fa-server(aria-hidden='true')
            span
                strong {{profile.name}}
                small {{address(profile)}}
        button.btn.btn-link.sign-out(type='button', [disabled]='saving', (click)='signOut()') 退出登录

    section.connection-editor(aria-label='SSH 连接编辑')
        ng-container(*ngIf='fields as edit; else selectHelp')
            .editor-heading
                h2 {{selected ? '编辑 SSH 连接' : '添加 SSH 连接'}}
                button.btn.btn-outline-secondary.btn-sm(*ngIf='selected', type='button', [disabled]='saving', (click)='connect(selected)') 连接
            form((ngSubmit)='save()')
                fieldset([disabled]='saving')
                    label(for='ssh-name') 连接名称
                    input.form-control(id='ssh-name', name='name', [(ngModel)]='edit.name', placeholder='例如 生产服务器')
                    .address-fields
                        div
                            label(for='ssh-address') IP 或主机名
                            input.form-control(id='ssh-address', name='host', [(ngModel)]='edit.host', placeholder='192.0.2.10')
                        div
                            label(for='ssh-port') 端口
                            input.form-control(id='ssh-port', name='port', type='number', min='1', max='65535', [(ngModel)]='edit.port')
                    label(for='ssh-user') SSH 用户名
                    input.form-control(id='ssh-user', name='username', [(ngModel)]='edit.user', autocomplete='off')
                    label(for='ssh-password') SSH 密码
                    input.form-control(id='ssh-password', name='password', type='password', [(ngModel)]='edit.password', autocomplete='new-password', [placeholder]='selected ? "留空保留当前凭据" : "可选"')
                    .editor-actions
                        button.btn.btn-primary(type='submit') {{saving ? '正在保存…' : '确定'}}
        ng-template(#selectHelp)
            .editor-placeholder
                i.fas.fa-terminal(aria-hidden='true')
                h2 {{connections.length ? '选择 SSH 连接' : '添加你的第一个连接'}}
                p.text-muted {{connections.length ? '单击编辑，双击连接。' : '点击「＋ SSH」填写服务器地址和登录信息。'}}
        p.editor-status.text-danger(*ngIf='error', role='alert') {{error}}
        p.editor-status.text-success(*ngIf='message', role='status') {{message}}
